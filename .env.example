# Optional override for QA or an alternate backend. Development defaults to localhost:3001;
# production builds default to https://student-outreach-backend.vercel.app.
VITE_API_BASE=https://your-app.vercel.app

# Public PostHog ingestion configuration. The project token is designed to be bundled in clients.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
